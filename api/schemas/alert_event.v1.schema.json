{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vision-project.local/schemas/alert_event.v1.schema.json",
  "title": "Algorithm Service Alert Event v1",
  "description": "Durable alert payload used by query APIs and asynchronous HTTP callbacks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_kind",
    "task_id",
    "camera_id",
    "run_id",
    "camera_profile",
    "event_type",
    "category",
    "severity",
    "occurred_at_ms",
    "algorithm"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "event_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,160}$"},
    "event_kind": {"const": "algorithm_alert"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,160}$"},
    "camera_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,160}$"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,160}$"},
    "camera_profile": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,160}$"},
    "event_type": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$"},
    "category": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$"},
    "severity": {"type": "integer", "minimum": 1, "maximum": 5},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "track_id": {"type": ["integer", "null"], "minimum": 0},
    "occurred_at_ms": {"type": "integer", "minimum": 0},
    "algorithm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "model", "config_version"],
      "properties": {
        "profile": {"type": "string", "minLength": 1, "maxLength": 160},
        "model": {"type": "string", "minLength": 1, "maxLength": 160},
        "config_version": {"type": "string", "minLength": 1, "maxLength": 160},
        "demo_classifier": {"type": "boolean", "default": false}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snapshot_url": {"type": "string", "pattern": "^/api/v1/alerts/[A-Za-z0-9_-]+/snapshot$"},
        "frame_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,160}$"}
      }
    },
    "payload": {
      "type": "object",
      "description": "Versioned event-specific details. Secrets and raw source/callback URLs are forbidden by the service validator."
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["not_scheduled", "pending", "delivering", "delivered", "retry", "dead_letter"]
        }
      },
      "description": "Present on query responses; callback payload producers may omit it."
    },
    "created_at_ms": {
      "type": "integer",
      "minimum": 0
    }
  }
}
